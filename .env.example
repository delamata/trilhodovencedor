# Copie este arquivo para ".env.local" e preencha com os valores do SEU
# projeto Supabase (o mesmo projeto já usado pelo app Oikos — veja o
# README, seção "Configuração Supabase"). NUNCA cole valores reais aqui
# neste arquivo de exemplo, e NUNCA faça commit de ".env.local".

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → anon public
# Pública por design do Supabase; a segurança vem do RLS, não do sigilo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → Project API keys → service_role
# SECRETA. Só é usada em código de servidor (route handlers / server actions),
# nunca é exposta ao navegador. Necessária para: criar login de aluno/professor
# na hora da matrícula, e para importação em lote.
SUPABASE_SERVICE_ROLE_KEY=

# Timezone oficial da aplicação (não altere sem necessidade).
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# URL pública onde o app está publicado (sem barra no final). Usada para
# montar links que saem do app: convite de login por e-mail, link de
# redefinição de senha, e o link/QR Code de presença (/presenca?token=...).
# Em desenvolvimento local pode deixar como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
